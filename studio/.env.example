# CreativeAI Studio — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit your real .env file to Git.

# ─── Supabase (required) ──────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─── Email (Resend) ───────────────────────────────────────────
# Sign up at https://resend.com — verify your domain for production
RESEND_API_KEY=re_your_key_here
RESEND_SENDER_EMAIL=noreply@yourdomain.com
EMAIL_FROM=CreativeAI Studio <noreply@yourdomain.com>

# ─── OpenAI Image Generation ──────────────────────────────────
IMAGE_PROVIDER=openai
OPENAI_API_KEY=sk-proj-your_key_here
OPENAI_IMAGE_MODEL=chatgpt-image-latest

# ─── Credits / Billing ────────────────────────────────────────
DEFAULT_FREE_CREDITS=25
CREDIT_COST_PER_GENERATION=5

# ─── Session Security ─────────────────────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=your-64-char-hex-secret-here

# ─── Token Encryption (for OAuth access tokens stored in DB) ──
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_ENCRYPTION_KEY=your-64-char-hex-secret-here

# ─── Meta (Facebook + Instagram) OAuth App ────────────────────
# Create at: https://developers.facebook.com/apps/
# Required permissions: pages_show_list, pages_manage_posts,
#   pages_read_engagement, instagram_basic, instagram_content_publish
# Add redirect URI: https://yourdomain.com/api/social/oauth/callback
META_APP_ID=your_meta_app_id
META_APP_SECRET=your_meta_app_secret

# ─── LinkedIn OAuth App ────────────────────────────────────────
# Create at: https://www.linkedin.com/developers/apps/
# Required permissions: r_liteprofile, w_member_social,
#   r_organization_admin, w_organization_social
# Add redirect URI: https://yourdomain.com/api/social/oauth/callback
LINKEDIN_CLIENT_ID=your_linkedin_client_id
LINKEDIN_CLIENT_SECRET=your_linkedin_client_secret

# ─── OAuth Redirect Base URL ──────────────────────────────────
# Development:  http://localhost:3001
# Production:   https://yourdomain.com
OAUTH_REDIRECT_BASE_URL=http://localhost:3001

# ─── Scheduler (Supabase Edge Function cron) ─────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SCHEDULER_SECRET=your-scheduler-secret-here

# For the Edge Function, also set:
# NEXT_APP_URL=https://yourdomain.com  (in Supabase dashboard secrets)
